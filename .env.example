# Copy this file to .env and fill in the values.

# --- Webhook mode (python -m umabot post) ------------------------------------
# Only for posting through a webhook instead of running the bot (see README).
# DISCORD_WEBHOOK_URL=

# --- Required for the bot ---------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=
# Channel(s) for the daily picture (comma-separated). Right-click a channel -> Copy Channel ID.
CHANNEL_IDS=

# --- Schedule ---------------------------------------------------------------
# 24-hour time and IANA time zone name (e.g. Europe/Warsaw, America/New_York).
POST_TIME=12:00
TIMEZONE=UTC
# Post right away on startup if today's picture was missed while the bot was offline.
CATCH_UP=true
# Optional text sent together with the daily picture.
DAILY_MESSAGE=Good morning, trainers! Here's today's Umamusume ✨

# Server ID: makes slash commands show up instantly in that server (optional).
GUILD_ID=

# --- Sources ----------------------------------------------------------------
# "auto" = every source whose credentials are set. Or a list, e.g. danbooru,safebooru
SOURCES=auto

# Optional: Danbooru account (Profile -> API Key) for friendlier rate limits.
DANBOORU_LOGIN=
DANBOORU_API_KEY=
# Gelbooru needs a free account: My Account -> Options -> API Access Credentials.
GELBOORU_USER_ID=
GELBOORU_API_KEY=
# Zerochan asks API users to identify with their Zerochan username.
ZEROCHAN_USERNAME=

# Search tags per source (defaults shown; change if a site renames its tag).
# DANBOORU_TAGS=umamusume
# SAFEBOORU_TAGS=umamusume
# GELBOORU_TAGS=umamusume
# KONACHAN_TAGS=uma_musume_pretty_derby
# ZEROCHAN_TAGS=Uma Musume: Pretty Derby

# --- SFW filtering ----------------------------------------------------------
# false = only "general" rated posts (strictest). true also allows "sensitive".
ALLOW_SENSITIVE=false
# Add tags to the built-in blacklist (wildcards allowed), e.g. skip comics:
EXTRA_BLACKLIST_TAGS=comic,4koma,monochrome
# Uncomment to REPLACE the built-in blacklist entirely (not recommended):
# BLACKLIST_TAGS=
# Skip posts with a score below this (sites without scores are unaffected). Empty = off.
MIN_SCORE=0

# --- Misc -------------------------------------------------------------------
# Upload the image as a file (more reliable than linking). Limit in MB.
UPLOAD_IMAGES=true
MAX_UPLOAD_MB=9
# If every source fails, retry this many times with this delay.
RETRY_COUNT=3
RETRY_DELAY_MINUTES=15
# Per-user cooldown for /uma in seconds (0 = none).
COMMAND_COOLDOWN=30
STATE_FILE=data/state.json

# --- Instagram account (python -m umabot instagram-prepare / instagram-publish) ---
# See "Instagram account" in the README. Needs a Business or Creator account.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Hashtags added to every caption (character names are added automatically).
INSTAGRAM_HASHTAGS=umamusume,umamusumeprettyderby,ウマ娘,fanart
